{
  "permissions": {
    "allow": [
      "Bash(mvn compile)",
      "Bash(mvn compile *)",
      "Bash(mvn clean *)",
      "Bash(mvn spring-boot:run)",
      "Bash(mvn test)",
      "Bash(mvn test *)",
      "Bash(mvn dependency:resolve)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/context-inject.sh",
            "statusMessage": "Injecting conventions context..."
          }
        ]
      }
    ]
  }
}
